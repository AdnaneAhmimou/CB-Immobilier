generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Bien {
  id              String   @id @default(uuid())
  type            String
  statut          String   @default("Disponible")
  transactionType String
  localisation    String
  superficie      Float
  pieces          Int
  prix            Float
  equipements     String?
  createdAt       DateTime @default(now())

  // Vente: vendeur vend → acheteur achète
  vendeurId       String?
  vendeur         Client?  @relation("BienVendeur",   fields: [vendeurId],   references: [id], onDelete: SetNull)
  acheteurId      String?
  acheteur        Client?  @relation("BienAcheteur",  fields: [acheteurId],  references: [id], onDelete: SetNull)

  // Location: bailleur loue → locataire prend
  bailleurId      String?
  bailleur        Client?  @relation("BienBailleur",  fields: [bailleurId],  references: [id], onDelete: SetNull)
  locataireId     String?
  locataire       Client?  @relation("BienLocataire", fields: [locataireId], references: [id], onDelete: SetNull)

  documents    Document[]    @relation
  visites      Visite[]      @relation
  offres       Offre[]       @relation
  transactions Transaction[] @relation
}

model Client {
  id          String   @id @default(uuid())
  nom         String
  prenom      String
  cin         String?  @unique
  telephone   String
  email       String?
  type        String
  budget      Float?
  commission  Float?
  statut      String   @default("Nouveau contact")
  criteres    String?
  createdAt   DateTime @default(now())

  biensAVendre   Bien[] @relation("BienVendeur")
  biensAchetes   Bien[] @relation("BienAcheteur")
  biensALouer    Bien[] @relation("BienBailleur")
  biensLoues     Bien[] @relation("BienLocataire")

  visites      Visite[]
  offres       Offre[]
  documents    Document[]
  transactions Transaction[]
}

model Agent {
  id        String  @id @default(uuid())
  nom       String
  telephone String
  email     String  @unique
  password  String

  visites   Visite[]
}

model Visite {
  id      String   @id @default(uuid())
  date    DateTime
  retour  String?

  bienId   String
  bien     Bien    @relation(fields: [bienId],   references: [id], onDelete: Cascade)
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId  String?
  agent    Agent?  @relation(fields: [agentId],  references: [id], onDelete: SetNull)
}

model Offre {
  id        String   @id @default(uuid())
  montant   Float
  statut    String   @default("En cours")
  createdAt DateTime @default(now())

  bienId   String
  bien     Bien   @relation(fields: [bienId],   references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String    @id @default(uuid())
  type          String
  prixFinal     Float
  commission    Float
  dateSignature DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  bienId   String
  bien     Bien   @relation(fields: [bienId],   references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model BienType {
  id    String @id @default(uuid())
  label String @unique
}

model Document {
  id        String   @id @default(uuid())
  nom       String
  filePath  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  bienId   String?
  bien     Bien?   @relation(fields: [bienId],   references: [id], onDelete: SetNull)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}
