# Postgres connection string. On Vercel, use the POOLED connection string your
# provider gives you (Vercel Postgres/Neon/Supabase all provide one) — serverless
# functions open a new connection per invocation and will exhaust a direct connection
# limit fast without pooling.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Cloudinary — Dashboard → Console → look for "Cloud name" / "API Key" / "API Secret"
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# Signs the session cookies. OPTIONAL: when unset, the key is derived from
# DATABASE_URL, which is already a secret and already set everywhere the app runs —
# so there is nothing to manage by hand. Set this explicitly if you would rather the
# session key be independent of the database password (rotating that password
# otherwise signs everyone out once). Generate one with:  openssl rand -base64 48
#
# What is NOT allowed is a key committed to this repo: anyone who could read it
# could forge a session for any account.
JWT_SECRET=

# Minutes of inactivity before a login expires (default 10). The session cookie also
# has no expiry of its own, so closing the browser/tab signs out immediately too —
# this only governs how long a left-open tab stays signed in.
SESSION_IDLE_MINUTES=10

# Comma-separated origins allowed to call the API from a browser. The admin app is
# same-origin and needs no entry; this is for the separate public website's contact
# form, e.g. https://cb-immobilier-site.vercel.app
ALLOWED_ORIGINS=
GMAIL_USER=chouaibbimmobilier@gmail.com
GMAIL_PASS=your_gmail_app_password_here
